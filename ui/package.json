{
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" -- && pnpm run build:editor",
    "build-only": "rsbuild build",
    "build:editor": "esbuild src/editor/main.ts --bundle --minify --format=iife --global-name=FiresideEditor --target=es2017 --charset=utf8 --outfile=../src/main/resources/static/fireside-editor.js",
    "dev": "rsbuild build --watch --env-mode=development",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "prettier": "prettier --write src/",
    "test:unit": "vitest --passWithNoTests",
    "type-check": "vue-tsc --build"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2
  },
  "dependencies": {
    "@halo-dev/api-client": "^2.25.1",
    "@halo-dev/components": "^2.25.1",
    "@halo-dev/ui-shared": "^2.25.1",
    "@tiptap/core": "~2.11.9",
    "@tiptap/extension-bold": "~2.11.9",
    "@tiptap/extension-code": "~2.11.9",
    "@tiptap/extension-document": "~2.11.9",
    "@tiptap/extension-hard-break": "~2.11.9",
    "@tiptap/extension-history": "~2.11.9",
    "@tiptap/extension-italic": "~2.11.9",
    "@tiptap/extension-link": "~2.11.9",
    "@tiptap/extension-paragraph": "~2.11.9",
    "@tiptap/extension-placeholder": "~2.11.9",
    "@tiptap/extension-strike": "~2.11.9",
    "@tiptap/extension-text": "~2.11.9",
    "@tiptap/pm": "~2.11.9",
    "axios": "^1.13.5",
    "vue": "^3.5.28",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@halo-dev/ui-plugin-bundler-kit": "^2.25.1",
    "@iconify-json/mingcute": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@rsbuild/core": "^1.7.3",
    "@rsbuild/plugin-sass": "^1.5.0",
    "@rsbuild/plugin-vue": "^1.1.1",
    "@tsconfig/node20": "^20.1.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.13.1",
    "@vitest/eslint-plugin": "^1.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "~10.0.1",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.8.3",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "unplugin-icons": "^23.0.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.3"
  },
  "packageManager": "pnpm@10.12.4"
}
